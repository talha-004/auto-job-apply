# ==============================================================================
# AutoApplyJobs — Complete Environment Configuration Template (.env.example)
# Copy this file to .env and fill in your personal values.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI & LLM PROVIDER CONFIGURATION
# ------------------------------------------------------------------------------
# Primary provider for resume tailoring, screening questions, and STAR stories.
# Options: ollama | gemini | deepseek | groq (Cascades automatically to fallback providers)
PRIMARY_LLM_PROVIDER=ollama

# Local Ollama Configuration (Default free & private zero-latency local runner)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5-coder:7b-instruct-q4_K_M
OLLAMA_TIMEOUT_SECONDS=120

# Cloud Google Gemini (Optional fast cloud provider: https://aistudio.google.com/)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# DeepSeek API (Optional cloud provider: https://platform.deepseek.com/)
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat

# Groq API (Optional ultra-fast cloud provider: https://console.groq.com/)
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile


# ------------------------------------------------------------------------------
# 2. JOB PLATFORM CREDENTIALS
# ------------------------------------------------------------------------------
# Leave password blank if you prefer logging in manually once in the browser.
# Once logged in, persistent session cookies are saved to backend/data/cookies/.

# LinkedIn
LINKEDIN_EMAIL=your_linkedin_email@example.com
LINKEDIN_PASSWORD=your_linkedin_password
LINKEDIN_USERNAME=

# Naukri.com
NAUKRI_EMAIL=your_naukri_email@example.com
NAUKRI_PASSWORD=your_naukri_password
NAUKRI_USERNAME=

# Indeed
INDEED_EMAIL=your_indeed_email@example.com
INDEED_PASSWORD=your_indeed_password

# DinDin (Optional)
DINDIN_EMAIL=your_email@example.com
DINDIN_PASSWORD=your_password


# ------------------------------------------------------------------------------
# 3. BOT RUNTIME, SAFETY & STEALTH LIMITS
# ------------------------------------------------------------------------------
# Set HEADLESS=True for silent background execution, or False to see browser live
HEADLESS=False

# Dry run mode simulates form filling without clicking final submission buttons
DRY_RUN=False

# Maximum applications per run
DEFAULT_MAX_APPLICATIONS=25

# Biometric human delays (seconds) between clicks and form navigation
MIN_DELAY_SECONDS=2.0
MAX_DELAY_SECONDS=5.0
COOLDOWN_BETWEEN_JOBS_SECONDS=15.0

# Retry attempts on failed forms before skipping
MAX_RETRIES_PER_JOB=2

# Maximum seconds to wait for user if a CAPTCHA appears
CAPTCHA_TIMEOUT_SECONDS=300

# Retain persistent Chromium profiles across sessions for seamless logins
USE_PERSISTENT_CONTEXT=True


# ------------------------------------------------------------------------------
# 4. DATABASE & PERSISTENCE
# ------------------------------------------------------------------------------
# Default is lightweight SQLite database in backend/data/autoapply.db
# For production PostgreSQL: postgresql://postgres:password@localhost:5432/autoapply_db
DATABASE_URL=sqlite:///./data/autoapply.db


# ------------------------------------------------------------------------------
# 5. 9-TO-5 BACKGROUND AUTONOMOUS SCHEDULER
# ------------------------------------------------------------------------------
# Automates morning profile booster, daily discovery, and business hours gating
SCHEDULER_ENABLED=False
SCHEDULER_MORNING_HOUR=9
SCHEDULER_MORNING_MINUTE=5
SCHEDULER_DAILY_CAP=25
SCHEDULER_ENFORCE_BUSINESS_HOURS=True
SCHEDULER_BUSINESS_START_HOUR=9
SCHEDULER_BUSINESS_END_HOUR=17
SCHEDULER_HEADLINE_REFRESH_HOURS=6


# ------------------------------------------------------------------------------
# 6. TELEGRAM MOBILE COMPANION (PUSH ALERTS & 1-TAP APPROVALS)
# ------------------------------------------------------------------------------
# Real-time mobile push notifications for human review, CAPTCHAs, and interviews.
# 1. Get bot token from @BotFather on Telegram (e.g. 7123456789:AAF...)
# 2. Get your personal chat ID from @userinfobot (e.g. 123456789)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=


# ------------------------------------------------------------------------------
# 7. OUTREACH & COLD EMAIL (SMTP)
# ------------------------------------------------------------------------------
# Configures automated outreach to recruiters and hiring managers
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASSWORD=your_gmail_app_password
SMTP_USE_TLS=True
SMTP_USE_SSL=False
SENDER_EMAIL=your_email@gmail.com
SENDER_NAME=Your Full Name
OUTREACH_REQUIRE_APPROVAL=True


# ------------------------------------------------------------------------------
# 8. RECRUITER INBOX & INTERVIEW MONITORING (IMAP)
# ------------------------------------------------------------------------------
# Syncs incoming emails to detect interview invites, rejections, and auto-draft RSVPs
INBOX_MONITOR_ENABLED=False
IMAP_HOST=imap.gmail.com
IMAP_PORT=993
IMAP_USER=your_email@gmail.com
IMAP_PASSWORD=your_gmail_app_password
IMAP_USE_SSL=True


# ------------------------------------------------------------------------------
# 9. DESKTOP, EMAIL & WEBHOOK NOTIFICATIONS
# ------------------------------------------------------------------------------
ENABLE_DESKTOP_NOTIFICATIONS=True
ENABLE_WEBHOOK_NOTIFICATIONS=False
WEBHOOK_URL=
NOTIFICATION_EMAIL=


# ------------------------------------------------------------------------------
# 10. NETWORK PROXY & VAULT ENCRYPTION (OPTIONAL)
# ------------------------------------------------------------------------------
# Optional HTTP/SOCKS5 proxy for stealth browsing (e.g. http://user:pass@1.2.3.4:8080)
PROXY_URL=

# Optional Fernet key for encrypting stored tokens and passwords at rest
ENCRYPTION_KEY=
